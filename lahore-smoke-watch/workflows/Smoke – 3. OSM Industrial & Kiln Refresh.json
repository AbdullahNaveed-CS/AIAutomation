        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "User-Agent",
              "value": "LahoreSmokeResearch/1.0 (academic pilot; n8n)"
            },
            {
              "name": "Accept",
              "value": "*/*"
            }
          ]
        },
        "sendBody": true,
        "contentType": "form-urlencoded",
        "bodyParameters": {
          "parameters": [
            {
              "name": "data",
              "value": "[out:json][timeout:90];(nwr[\"industrial\"=\"brick_kiln\"](31.15,73.9,31.85,74.7);nwr[\"craft\"=\"brickmaker\"](31.15,73.9,31.85,74.7);nwr[\"man_made\"=\"works\"](31.15,73.9,31.85,74.7);nwr[\"landuse\"=\"industrial\"](31.15,73.9,31.85,74.7););out center tags 1500;"
            }
          ]
        },
        "options": {
          "timeout": 120000
        }
      },
      "id": "0de1ad75-886c-44d1-91da-71d8c3b9a2b2",
      "name": "Fetch OSM Facilities",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        96
      ],
      "retryOnFail": true,
      "maxTries": 4,
      "waitBetweenTries": 20000,
      "alwaysOutputData": true,
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "var runAt = new Date().toISOString();\nvar allIn = $input.all();\nvar res = allIn.length ? allIn[0].json : null;\nfunction logItem(status, records, message) {\n  return { json: { kind: 'log', run_at: runAt, run_id: 'osm' + Date.now(), source: 'osm-facilities', status: status, records: records, message: String(message).substring(0, 400) } };\n}\nif (!res || !Array.isArray(res.elements)) {\n  var err = res && res.error ? JSON.stringify(res.error) : 'Overpass returned no elements';\n  return [logItem('failed', 0, err)];\n}\nvar rank = { brick_kiln: 0, works: 1, industrial_land: 2 };\nvar items = [];\nfor (var i = 0; i < res.elements.length; i++) {\n  var el = res.elements[i];\n  var tags = el.tags || {};\n  var lat = el.lat !== undefined ? el.lat : (el.center ? el.center.lat : null);\n  var lon = el.lon !== undefined ? el.lon : (el.center ? el.center.lon : null);\n  if (lat === null || lon === null) continue;\n  var type = 'industrial_land';\n  var nm = String(tags.name || '');\n  if (tags.industrial === 'brick_kiln' || tags.craft === 'brickmaker' || /brick|bhatta|kiln/i.test(nm)) type = 'brick_kiln';\n  else if (tags.man_made === 'works') type = 'works';\n  items.push({ kind: 'facility', osm_key: el.type + '/' + el.id, facility_type: type, name: nm || String(tags.industrial || tags.landuse || ''), lat: lat, lon: lon });\n}\nitems.sort(function (a, b) { return rank[a.facility_type] - rank[b.facility_type]; });\nvar kept = items.slice(0, 1500);\nvar out = kept.map(function (x) { return { json: x }; });\nout.push(logItem('ok', kept.length, 'Facilities refreshed from OpenStreetMap: ' + kept.length));\nreturn out;"
      },
