      "id": "8ac7f767-d61a-4212-bdad-073dd4b14bf0",
      "name": "Hourly Ground Pull",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.3,
      "position": [
        0,
        96
      ]
    },
    {
      "parameters": {
        "url": "https://api.openaq.org/v3/locations?bbox=74.0,31.2,74.7,31.85&parameters_id=2&limit=100",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "options": {
          "timeout": 30000
        }
      },
      "id": "d438b713-bfbc-420d-a068-aaa2a4aa8156",
      "name": "Fetch OpenAQ Locations",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        224,
        96
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpTemplatedCustomAuth": {
          "id": "qsCODFQNZorWXxRD",
          "name": "OpenAQ API Key (NOWAK A)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "var allIn = $input.all();\nvar res = allIn.length ? allIn[0].json : null;\nvar nowMs = Date.now();\nif (!res || !Array.isArray(res.results)) {\n  var err = res && res.error ? JSON.stringify(res.error).substring(0, 300) : 'OpenAQ returned no results object';\n  return [{ json: { location_id: null, error: err } }];\n}\nvar picks = [];\nfor (var i = 0; i < res.results.length; i++) {\n  var loc = res.results[i];\n  var last = loc.datetimeLast && loc.datetimeLast.utc ? Date.parse(loc.datetimeLast.utc) : NaN;\n  if (!isFinite(last) || (nowMs - last) > 6 * 3600000) continue;\n  var ids = [];\n  var sensors = loc.sensors || [];\n  for (var s = 0; s < sensors.length; s++) {\n    if (sensors[s].parameter && (sensors[s].parameter.id === 2 || sensors[s].parameter.name === 'pm25')) ids.push(sensors[s].id);\n  }\n  if (!ids.length || !loc.coordinates) continue;\n  picks.push({ location_id: loc.id, name: loc.name, lat: loc.coordinates.latitude, lon: loc.coordinates.longitude, pm25_sensor_ids: ids, last: last });\n}\npicks.sort(function (a, b) { return b.last - a.last; });\nvar top = picks.slice(0, 30);\nif (!top.length) return [{ json: { location_id: null, error: null } }];\nreturn top.map(function (p) { return { json: p }; });"
      },
      "id": "d52ce1ce-d6bb-4070-bae1-812a55157e07",
      "name": "Pick Active Locations",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        448,
        96
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "url": "=https://api.openaq.org/v3/locations/{{ $json.location_id || 2178 }}/latest",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpTemplatedCustomAuth",
        "options": {
          "batching": {
            "batch": {
              "batchSize": 5,
              "batchInterval": 1500
            }
          },
          "timeout": 30000
        }
      },
      "id": "84330503-db64-40d6-8ef4-1cadd8681aec",
      "name": "Fetch Latest Readings",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.3,
      "position": [
        672,
        96
      ],
      "alwaysOutputData": true,
      "credentials": {
        "httpTemplatedCustomAuth": {
          "id": "qsCODFQNZorWXxRD",
          "name": "OpenAQ API Key (NOWAK A)"
        }
      },
      "onError": "continueRegularOutput"
    },
    {
      "parameters": {
        "jsCode": "var runAt = new Date().toISOString();\nvar runId = 'aq' + Date.now();\nvar nowMs = Date.now();\nvar out = [];\nfunction logItem(status, records, message) {\n  return { json: { kind: 'log', run_at: runAt, run_id: runId, source: 'openaq', status: status, records: records, message: String(message).substring(0, 400) } };\n}\nvar picks = $('Pick Active Locations').all().map(function (i) { return i.json; });\nvar latest = $input.all().map(function (i) { return i.json; });\nif (!picks.length || !picks[0].location_id) {\n  if (picks.length && picks[0].error) return [logItem('failed', 0, picks[0].error)];\n  return [logItem('ok', 0, 'No OpenAQ PM2.5 stations reported in the last 6 hours inside the Lahore area')];\n}\nvar stale = 0;\nvar failed = 0;\nvar bad = 0;\nfor (var i = 0; i < picks.length; i++) {\n  var pick = picks[i];\n  var item = latest[i];\n  if (!item || item.error || !Array.isArray(item.results)) { failed++; continue; }\n  var got = false;\n  for (var r = 0; r < item.results.length; r++) {\n    var res = item.results[r];\n    if (pick.pm25_sensor_ids.indexOf(res.sensorsId) === -1) continue;\n    var v = Number(res.value);\n    if (!isFinite(v) || v < 0 || v > 1500) { bad++; continue; }\n    var t = res.datetime && res.datetime.utc ? Date.parse(res.datetime.utc) : NaN;\n    if (!isFinite(t) || (nowMs - t) > 3 * 3600000) { stale++; continue; }\n    out.push({ json: { kind: 'obs', observed_at: new Date(t).toISOString(), cell_id: 'gs_' + pick.location_id, lat: pick.lat, lon: pick.lon, pm25: v, source: 'openaq' } });\n    got = true;\n  }\n}\nvar status = out.length === 0 ? 'failed' : (failed > 0 ? 'partial' : 'ok');\nout.push(logItem(status, out.length, 'Stations queried: ' + picks.length + ', valid readings: ' + out.length + ', failed requests: ' + failed + ', stale: ' + stale + ', invalid values removed: ' + bad));\nreturn out;"
      },
